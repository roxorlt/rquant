[Unit]
Description=rQuant single-connection L2 collector
After=network-online.target
Wants=network-online.target
# 断线自愈（2026-11-06 P0）：进程非零退出/异常终止时自动重启；5 分钟内 3 次后放弃并告警，
# 避免供应商会话抖动时无限重连。Restart=no 曾导致 09:31 peer_closed 后静默失败 8 分钟。
StartLimitIntervalSec=300
StartLimitBurst=3
OnFailure=rquant-alert@%n.service

[Service]
Type=simple
User=lighthouse
WorkingDirectory=/home/lighthouse/rquant-l2-state
ExecStart=/usr/bin/env -i PATH=/usr/local/bin:/usr/bin:/bin LANG=C.UTF-8 TZ=Asia/Shanghai PYTHONDONTWRITEBYTECODE=1 RQUANT_DISABLE_DOTENV=1 RQUANT_WEB_WARM=0 /home/lighthouse/rquant-l2-rel/current/.venv/bin/python -m rquant.l2 --resident --cache-root /home/lighthouse/rquant-l2-state/cache --bootstrap-file /home/lighthouse/rquant-l2-private/bootstrap.bin --order-template /home/lighthouse/rquant-l2-private/order-template.bin --trade-template /home/lighthouse/rquant-l2-private/trade-template.bin --trade-pages 1 --order-pages 1 --max-reconnects 0 --control-root /home/lighthouse/rquant-l2-state/control --capacity-file /home/lighthouse/rquant-l2-state/capacity.json
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
PrivateTmp=yes
ReadOnlyPaths=/home/lighthouse/rquant-l2-private /home/lighthouse/rquant-l2-state/control /home/lighthouse/rquant-l2-state/capacity.json
ReadWritePaths=/home/lighthouse/rquant-l2-state/cache
Restart=on-failure
RestartSec=10s
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
