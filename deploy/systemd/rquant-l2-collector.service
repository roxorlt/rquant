[Unit]
Description=rQuant single-connection L2 collector
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=1

[Service]
Type=simple
User=lighthouse
WorkingDirectory=/home/lighthouse/rquant-l2-state
ExecStart=/usr/bin/env -i PATH=/usr/local/bin:/usr/bin:/bin LANG=C.UTF-8 TZ=Asia/Shanghai PYTHONDONTWRITEBYTECODE=1 RQUANT_DISABLE_DOTENV=1 RQUANT_WEB_WARM=0 /home/lighthouse/rquant-l2-rel/current/.venv/bin/python -m rquant.l2 --resident --cache-root /home/lighthouse/rquant-l2-state/cache --bootstrap-file /home/lighthouse/rquant-l2-private/bootstrap.bin --order-template /home/lighthouse/rquant-l2-private/order-template.bin --trade-template /home/lighthouse/rquant-l2-private/trade-template.bin --trade-pages 1 --order-pages 1 --max-reconnects 0
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
PrivateTmp=yes
ReadOnlyPaths=/home/lighthouse/rquant-l2-private
ReadWritePaths=/home/lighthouse/rquant-l2-state/cache
Restart=no
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
