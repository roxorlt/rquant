[Unit]
Description=rQuant Serving Workload Plane

[Slice]
CPUAccounting=true
CPUWeight=500
# 见 rquant-live.slice：serving 面全是请求驱动的 dashboard/panorama/canvas/page-control
# 与 serving publisher，绝大多数时间空转，30% 一核足够渲染突发，且 60+30=90% ≤ 100%。
CPUQuota=30%
IOAccounting=true
IOWeight=500
MemoryAccounting=true
# 2026-09-20 owner 裁决（#268 / #271）：512M 从 09-08 起就持续压在回收线之上
# （memory.events high 累计 22.5M 次，PSI 常态约 95%）。dashboard 实测常驻
# ~700 MiB，一家就超了 512M，再加 runtime-health / serving role 合计约 300 MiB，
# 改成 1536M = dashboard ~700M + health/serving role ~300M + 余量。
MemoryHigh=1536M
TasksAccounting=true
TasksMax=256
