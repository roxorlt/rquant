[Unit]
Description=rQuant isolated candidate publisher (%i)
After=network-online.target
Wants=network-online.target
OnFailure=rquant-alert@%n.service
StartLimitIntervalSec=600s
StartLimitBurst=5

[Service]
Type=simple
User=lighthouse
Group=lighthouse
WorkingDirectory=/home/lighthouse/rquant
Environment=APP_ENV=prod RQUANT_DISABLE_DOTENV=1
Slice=rquant-live.slice
ExecStart=/usr/bin/python3.11 -I -S /usr/local/libexec/rquant-runtime-exec.pyz --role candidate_publisher

Restart=on-failure
RestartSec=10s
TimeoutStartSec=120s
TimeoutStopSec=60s
SuccessExitStatus=0

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
InaccessiblePaths=/home/lighthouse/rquant/.env -/home/lighthouse/rquant/data/runtime/current/secrets -/home/lighthouse/rquant/data/runtime/current/credentials
ProtectProc=invisible
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
ReadWritePaths=/home/lighthouse/rquant/data/runtime/control/candidates/%i /home/lighthouse/rquant/data/runtime/live/candidates/%i

StandardOutput=journal
StandardError=journal
