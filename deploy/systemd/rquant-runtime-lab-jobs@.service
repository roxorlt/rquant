[Unit]
Description=rQuant isolated Lab Jobs serving authority publisher (%i)
OnFailure=rquant-alert@%n.service
StartLimitIntervalSec=1800s
StartLimitBurst=3

[Service]
Type=simple
User=lighthouse
Group=lighthouse
WorkingDirectory=/home/lighthouse/rquant
EnvironmentFile=/home/lighthouse/rquant/data/runtime/current/runtime.env
Environment=APP_ENV=prod RQUANT_DISABLE_DOTENV=1
Slice=rquant-research.slice
ExecStart=/usr/local/libexec/rquant-workload-arbiter research -- /home/lighthouse/rquant/.venv/bin/python -m rquant.runtime_service_main --manifest /home/lighthouse/rquant/data/runtime/current/manifests/%i.json --control-root /home/lighthouse/rquant/data/runtime/control/lab-jobs-publishers/%i --expected-commit ${RQUANT_RUNTIME_COMMIT} --expected-generation ${RQUANT_RUNTIME_GENERATION} --expected-kind lab_jobs_publisher

Restart=on-failure
RestartSec=30s
TimeoutStartSec=120s
TimeoutStopSec=60s
SuccessExitStatus=0 75

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
InaccessiblePaths=/home/lighthouse/rquant/.env -/home/lighthouse/rquant/data/runtime/current/secrets -/home/lighthouse/rquant/data/runtime/current/credentials /etc/rquant/lab-claim-finalizer-runtime
ProtectProc=invisible
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
ReadWritePaths=/home/lighthouse/rquant/data/runtime/control/lab-jobs-publishers/%i /home/lighthouse/rquant/data/runtime/research/serving-authorities/lab-jobs
ReadOnlyPaths=-/home/lighthouse/rquant/data/runtime/research/lab_jobs.sqlite3

StandardOutput=journal
StandardError=journal
