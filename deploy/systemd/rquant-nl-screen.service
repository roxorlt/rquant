[Unit]
Description=rQuant NL 选股 (Streamlit, independent app)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Slice=rquant-serving.slice
User=lighthouse
Group=lighthouse
WorkingDirectory=/home/lighthouse/rquant
EnvironmentFile=/home/lighthouse/rquant/.env
Environment=RQUANT_SERVING_ROOT=/home/lighthouse/rquant/data/runtime/serving
ExecStart=/home/lighthouse/rquant/.venv/bin/streamlit run \
    /home/lighthouse/rquant/src/rquant/dashboard/nl_screen.py \
    --server.port 8502 \
    --server.address 0.0.0.0 \
    --server.headless true \
    --browser.gatherUsageStats false

Restart=always
RestartSec=10
TimeoutStartSec=60

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
