[Unit]
Description=rQuant PageControl loopback authority
After=network-online.target
Wants=network-online.target
OnFailure=rquant-alert@%n.service

[Service]
Type=simple
Slice=rquant-serving.slice
User=lighthouse
Group=lighthouse
WorkingDirectory=/home/lighthouse/rquant
Environment="APP_ENV=prod" "RQUANT_DISABLE_DOTENV=1" "RQUANT_PAGE_CONTROL_HOST=127.0.0.1" "RQUANT_PAGE_CONTROL_PORT=8767"
ExecStart=/usr/bin/python3.11 -I -S /usr/local/libexec/rquant-runtime-exec.pyz --role page_control --instance svc-981cb38218dd899500ee1592a504790a57d459c946bbc53c8e210f299cf1980b
Restart=on-failure
RestartSec=5s
TimeoutStartSec=30s
TimeoutStopSec=30s

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ProtectProc=invisible
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
ReadWritePaths=/home/lighthouse/rquant/data/runtime/control /home/lighthouse/rquant/data/runtime/serving /home/lighthouse/rquant/logs
InaccessiblePaths=/home/lighthouse/rquant/.env -/home/lighthouse/rquant/data/runtime/current/secrets -/home/lighthouse/rquant/data/runtime/current/credentials

# Cloud gate before install: systemd-analyze verify rquant-page-control.service
# No timer applies; it is a long-running loopback service.

StandardOutput=journal
StandardError=journal
