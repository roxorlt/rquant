[Unit]
Description=rQuant L2 collector self-heal + freshness watchdog (2026-11-06 P0)
After=rquant-l2-collector.service
# watchdog 自身失败也要告警（它静默失效 = 断线无人发现）
OnFailure=rquant-alert@%n.service

[Service]
Type=oneshot
User=lighthouse
Group=lighthouse
WorkingDirectory=/home/lighthouse/rquant
EnvironmentFile=/home/lighthouse/rquant/.env
ExecStart=/home/lighthouse/rquant/scripts/l2-collector-watchdog.sh
TimeoutStartSec=60
StandardOutput=journal
StandardError=journal
