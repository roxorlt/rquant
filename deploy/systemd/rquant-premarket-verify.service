[Unit]
Description=rQuant post-capture check: today's reference-slow batch and serving-authority exist
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=-/home/lighthouse/rquant/.env
ExecStart=/home/lighthouse/rquant/scripts/premarket-runtime.sh verify
TimeoutStartSec=10min
StandardOutput=journal
StandardError=journal
