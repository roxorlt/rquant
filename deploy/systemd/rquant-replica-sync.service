[Unit]
Description=rQuant DuckDB Read-Only Replica Sync (for dashboard/canvas/nl-screen)
After=network-online.target
# OnFailure 必须在 [Unit] 段（之前误放在 [Service] 段被 systemd 静默 ignore，
# alert 链路永远不会触发；5/20 部署后 journalctl 发现）
OnFailure=rquant-alert@%n.service

[Service]
Type=oneshot
Slice=rquant-maintenance.slice
TasksMax=64
User=lighthouse
Group=lighthouse
WorkingDirectory=/home/lighthouse/rquant
ExecStart=/usr/local/libexec/rquant-workload-arbiter maintenance -- /home/lighthouse/rquant/scripts/sync-readonly-replica.sh

TimeoutStartSec=120
StandardOutput=journal
StandardError=journal

# 副本验证失败 (exit 2) 是预期场景（cp 撞 monitor 写入），不算 failure，不触发 OnFailure
SuccessExitStatus=2

[Install]
WantedBy=multi-user.target
