[Unit]
Description=rQuant Daily receipt signer socket

[Socket]
ListenStream=/run/rquant/daily-receipt-signer.sock
SocketUser=root
SocketGroup=lighthouse
SocketMode=0660
DirectoryMode=0755
RemoveOnStop=true
Service=rquant-daily-receipt-signer.service

[Install]
WantedBy=sockets.target

# Cloud deployment gate: systemd-analyze verify rquant-daily-receipt-signer.socket rquant-daily-receipt-signer.service
