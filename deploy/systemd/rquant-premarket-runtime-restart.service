[Unit]
Description=rQuant pre-market restart: reference-slow source+publisher, then serving (before 09:20)
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/lighthouse/rquant
EnvironmentFile=-/home/lighthouse/rquant/.env
ExecStart=/home/lighthouse/rquant/scripts/premarket-runtime.sh start
TimeoutStartSec=10min
StandardOutput=journal
StandardError=journal
