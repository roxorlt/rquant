[Unit]
Description=rQuant Health Dashboard (Streamlit)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Slice=rquant-serving.slice
User=lighthouse
Group=lighthouse
WorkingDirectory=/home/lighthouse/rquant
EnvironmentFile=/home/lighthouse/rquant/.env
ExecStart=/home/lighthouse/rquant/.venv/bin/streamlit run \
    /home/lighthouse/rquant/src/rquant/dashboard/app.py \
    --server.port 8501 \
    --server.address 0.0.0.0 \
    --server.headless true \
    --browser.gatherUsageStats false

Restart=always
RestartSec=10
TimeoutStartSec=60

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
