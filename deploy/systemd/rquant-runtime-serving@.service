[Unit]
Description=rQuant isolated serving runtime (%i)
OnFailure=rquant-alert@%n.service
StartLimitIntervalSec=900s
StartLimitBurst=4

[Service]
Type=simple
User=lighthouse
Group=lighthouse
WorkingDirectory=/home/lighthouse/rquant
Environment=APP_ENV=prod RQUANT_DISABLE_DOTENV=1
Slice=rquant-serving.slice
ExecStart=/usr/bin/python3.11 -I -S /usr/local/libexec/rquant-runtime-exec.pyz --role serving_publisher --instance %i

Restart=on-failure
RestartSec=20s
TimeoutStartSec=120s
TimeoutStopSec=60s
SuccessExitStatus=0

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
InaccessiblePaths=/home/lighthouse/rquant/.env -/home/lighthouse/rquant/data/runtime/current/secrets -/home/lighthouse/rquant/data/runtime/current/credentials
ProtectProc=invisible
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
ReadWritePaths=-/home/lighthouse/rquant/data/runtime/control/serving-publishers/%i -/home/lighthouse/rquant/data/runtime/serving
ReadOnlyPaths=-/home/lighthouse/rquant/data/runtime/control -/home/lighthouse/rquant/data/runtime/live/notifications -/home/lighthouse/rquant/data/runtime/live/paper-brokers -/home/lighthouse/rquant/data/runtime/live/signal-bus -/home/lighthouse/rquant/data/runtime/research

StandardOutput=journal
StandardError=journal
