[Unit]
Description=rQuant alert relay (used by OnFailure= hooks, %i = failed unit name)

[Service]
Type=oneshot
User=lighthouse
Group=lighthouse
WorkingDirectory=/home/lighthouse/rquant
EnvironmentFile=/home/lighthouse/rquant/.env
ExecStart=/home/lighthouse/rquant/scripts/alert-on-failure.sh %i

TimeoutStartSec=30
StandardOutput=journal
StandardError=journal
