[Unit]
Description=rQuant Live Runtime Role Plane

[Slice]
CPUAccounting=true
# 与 live 面里每个常驻 unit 的默认权重相同（100）：14 个 role 模板合起来只算 live 内部的
# 「一个同侪」，而不是 20 个。加上下面的 quota，monitor / daily / alert@ 不会被 role 数量稀释。
CPUWeight=100
# 裁决 21 要限的「运行时工作面」就是这些 role，闸门下沉到这个子 slice：
# 8 个基线 role 空转各 3–5%（合计 24–40%）跑得开，20 个 role（60–100%）会被
# 限流——这正是目的。限额压在 role 身上，live 面本身不设 quota，常驻服务因此
# 保持优先。
# 2026-09-24 owner 裁决（"cpu可以调到2个"，issue #297）：09-24 开盘前 20 个 Route A
# role 挤在 0.6 核里，cpu.stat 的 nr_throttled 从 00:28 的 9,610 涨到 10:42 的
# 127,336（开盘前约 26% 的墙钟时间在被限流，00:10 冷启动期间 CPU PSI 一度约
# 93%，首轮迭代耗时 22 分钟），reference-slow publisher 约 26MB 的 registry
# commit 来不及在 5s 可见性护栏内跑完，当天的 reference 生成从未发布；同期
# 4 核主机整体仍有约 85% 空闲。父 slice rquant-live.slice 与 rquant.slice 都不设
# CPUQuota，200% 能被完整吃下，因此把这个子 slice 从 60% 提到 200%（2 个核）。
CPUQuota=200%
IOAccounting=true
IOWeight=100
MemoryAccounting=true
# 2026-09-20 owner 裁决（#268 / #271）：旧配置是「从 live 的 3840M 里切一份给
# role 面」，1536M 只覆盖当时 8 个基线 role；生产实际跑到 18 个常驻 role，anon
# 2323 MiB + page cache 合计约 3756 MiB，加上 monitor 实测 MemoryPeak 2095 MiB，
# 早已超出 live 3840M 的总预算，回收压力全打在 monitor 头上（09-14 开盘 monitor
# 卡死、09-16 17:00 daily 跑了 19 分钟，根因是 memory.high 节流，不是 I/O）。
# 生产曾用 systemctl set-property 把这个子 slice 临时调到 4096M，但父 slice
# rquant-live.slice 当时仍是 3840M——子 slice 预算（4096M）超过父 slice 上限
# （3840M）本身就是配置反转，这正是这次要修的 bug：子 slice 的 MemoryHigh 永远
# 不能超过父 slice。这次把 role 面改为独立 4096M 预算，父面 rquant-live.slice
# 同步提到 7680M，4096M 完整落在父预算之内，role 面不再和 monitor / daily 抢
# 回收压力（详见 rquant-live.slice 的评论）。
MemoryHigh=4096M
TasksAccounting=true
TasksMax=256
