[Unit]
Description=rQuant isolated Strategy Lab artifact catalog (%i)
OnFailure=rquant-alert@%n.service
StartLimitIntervalSec=1800s
StartLimitBurst=3

[Service]
Type=simple
User=lighthouse
Group=lighthouse
WorkingDirectory=/home/lighthouse/rquant
Environment=APP_ENV=prod RQUANT_DISABLE_DOTENV=1
Slice=rquant-research.slice
ExecStart=/usr/local/libexec/rquant-workload-arbiter research -- /usr/bin/python3.11 -I -S /usr/local/libexec/rquant-runtime-exec.pyz --role lab_artifact_catalog --instance %i

Restart=on-failure
RestartSec=30s
TimeoutStartSec=120s
TimeoutStopSec=60s
SuccessExitStatus=0 75

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
InaccessiblePaths=/home/lighthouse/rquant/.env -/home/lighthouse/rquant/data/runtime/current/secrets -/home/lighthouse/rquant/data/runtime/current/credentials
ProtectProc=invisible
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
ReadWritePaths=-/home/lighthouse/rquant/data/runtime/control/artifact-catalogs/%i -/home/lighthouse/rquant/data/runtime/research/artifact-catalogs/%i -/home/lighthouse/rquant/data/runtime/research/artifact-retention/svc-248ba9b29fdc243fcd4f7d09641fbdedd61871ffeea693ea4eb26f36f264b349/catalog-registration-outbox
ReadOnlyPaths=-/home/lighthouse/rquant/data/runtime/research/final-artifacts -/home/lighthouse/rquant/data/runtime/research/lab_jobs.sqlite3 -/home/lighthouse/rquant/data/runtime/research/research_ro.duckdb -/home/lighthouse/rquant/data/runtime/research/experiment_registry.sqlite3

StandardOutput=journal
StandardError=journal
