[Unit]
Description=rQuant isolated slow-reference publisher (%i)
After=network-online.target
Wants=network-online.target
OnFailure=rquant-alert@%n.service
StartLimitIntervalSec=600s
StartLimitBurst=5

[Service]
Type=simple
User=lighthouse
Group=lighthouse
WorkingDirectory=/home/lighthouse/rquant
EnvironmentFile=/home/lighthouse/rquant/data/runtime/current/runtime.env
Environment=APP_ENV=prod RQUANT_DISABLE_DOTENV=1
LoadCredentialEncrypted=capabilities.json:/etc/credstore.encrypted/rquant-runtime/instances/%i/current.cred
Slice=rquant-live.slice
ExecStart=/home/lighthouse/rquant/.venv/bin/python -m rquant.runtime_service_main --manifest /home/lighthouse/rquant/data/runtime/current/manifests/%i.json --control-root /home/lighthouse/rquant/data/runtime/control/reference-slow-publishers/%i --expected-commit ${RQUANT_RUNTIME_COMMIT} --expected-generation ${RQUANT_RUNTIME_GENERATION} --expected-kind reference_slow_publisher

Restart=on-failure
RestartSec=10s
TimeoutStartSec=120s
TimeoutStopSec=60s
SuccessExitStatus=0

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
InaccessiblePaths=/home/lighthouse/rquant/.env -/home/lighthouse/rquant/data/runtime/current/secrets -/home/lighthouse/rquant/data/runtime/current/credentials
ProtectProc=invisible
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
ReadOnlyPaths=-/home/lighthouse/rquant/data/runtime/authorities/market-calendar -/home/lighthouse/rquant/data/runtime/live/reference-slow
ReadWritePaths=/home/lighthouse/rquant/data/runtime/control/reference-slow-publishers/%i /home/lighthouse/rquant/data/runtime/authorities/reference-slow

StandardOutput=journal
StandardError=journal
