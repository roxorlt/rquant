# /etc/rquant-r2-published-archive.env  (owner lighthouse, mode 0600) -- NAMES ONLY.
# Read directly by serving_generations_retention.py --credentials-file (not an EnvironmentFile).
# Token rquant-published-archive-rw: Object Read & Write on this bucket only.
R2_ARCHIVE_ACCESS_KEY_ID=<access key id>
R2_ARCHIVE_SECRET_ACCESS_KEY=<secret>
R2_ARCHIVE_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ARCHIVE_BUCKET=rquant-published-archive
