<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.roxor.rquant-sync</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/roxor/brain/30-projects/rQuant/scripts/sync-from-cloud.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/roxor/brain/30-projects/rQuant</string>

    <!-- 每小时触发一次（业务时段脚本内部跳过） -->
    <key>StartInterval</key>
    <integer>3600</integer>

    <!-- 笔记本启动 / launchd 加载时立即拉一次（追上离线期间的更新） -->
    <key>RunAtLoad</key>
    <true/>

    <!-- 失败不重启（脚本自带 3 次重试 + PushDeer 告警） -->
    <key>StandardOutPath</key>
    <string>/Users/roxor/brain/30-projects/rQuant/logs/launchd-sync-stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/roxor/brain/30-projects/rQuant/logs/launchd-sync-stderr.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
