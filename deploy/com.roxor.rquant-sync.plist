<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.roxor.rquant-sync</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/roxor/brain/30-projects/rQuant/scripts/sync-from-cloud.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/roxor/brain/30-projects/rQuant</string>

    <!-- 每 5 分钟触发；脚本内部判断同步窗口（盘中 09:30-15:05 + 日终 17:10-17:30），
         其他时段直接 exit。盘中每 5 分钟备份 monitor_event，日终窗口覆盖流水线产出。 -->
    <key>StartInterval</key>
    <integer>300</integer>

    <!-- 笔记本启动 / launchd 加载时立即拉一次（追上离线期间的更新） -->
    <key>RunAtLoad</key>
    <true/>

    <!-- 失败不重启（脚本自带 3 次重试 + PushDeer 告警） -->
    <key>StandardOutPath</key>
    <string>/Users/roxor/brain/30-projects/rQuant/logs/launchd-sync-stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/roxor/brain/30-projects/rQuant/logs/launchd-sync-stderr.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
