#!/usr/bin/python3
"""Root-owned, fixed-destination systemd credential sealing helper."""

from __future__ import annotations

import base64
import json
import os
import re
import secrets
import stat
import subprocess
import sys
import tempfile
from collections.abc import Callable
from dataclasses import dataclass
from pathlib import Path

STORE_ROOT = Path("/etc/credstore.encrypted/rquant-runtime")
_INSTANCE_PATTERN = re.compile(r"^svc-[0-9a-f]{64}$")
_GENERATION_PATTERN = re.compile(r"^[0-9a-f]{64}$")
_MAX_REQUEST_BYTES = 4 * 1024 * 1024
_MAX_CREDENTIAL_BYTES = 1024 * 1024
_SERVICE_KINDS = frozenset(
    {
        "market_minute_source",
        "candidate_publisher",
        "feature_live",
        "strategy_live",
        "signal_router",
        "notifier",
        "paper_constraint_publisher",
        "paper_broker",
        "runtime_health_publisher",
        "lab_jobs_publisher",
        "promotions_publisher",
        "serving_publisher",
    }
)


@dataclass(frozen=True)
class _DecodedRequest:
    operation: str
    credentials: dict[str, bytes] | None = None
    transaction_id: str | None = None
    bundle_generation: str | None = None
    instances: tuple[str, ...] = ()
    action: str | None = None


def _unique_object(pairs: list[tuple[str, object]]) -> dict[str, object]:
    result: dict[str, object] = {}
    for key, value in pairs:
        if key in result:
            raise ValueError("duplicate JSON key")
        result[key] = value
    return result


def _decode_credentials(raw_credentials: object) -> dict[str, bytes]:
    if not isinstance(raw_credentials, dict):
        raise ValueError("credential seal request credentials are invalid")
    credentials: dict[str, bytes] = {}
    for instance, encoded in sorted(raw_credentials.items()):
        if not isinstance(instance, str) or _INSTANCE_PATTERN.fullmatch(instance) is None:
            raise ValueError("credential seal request instance is invalid")
        if not isinstance(encoded, str):
            raise ValueError("credential seal request payload is invalid")
        raw = base64.b64decode(encoded, validate=True)
        if not raw or len(raw) > _MAX_CREDENTIAL_BYTES:
            raise ValueError("runtime credential size is unsafe")
        credential = json.loads(raw, object_pairs_hook=_unique_object)
        if (
            not isinstance(credential, dict)
            or set(credential)
            != {
                "schema_version",
                "service_id",
                "service_kind",
                "instance_name",
                "bundle_generation",
                "capabilities",
            }
            or credential["schema_version"] != 2
            or not isinstance(credential["capabilities"], dict)
        ):
            raise ValueError("runtime credential shape is invalid")
        if not isinstance(credential["service_id"], str) or not credential["service_id"].strip():
            raise ValueError("runtime credential service id is invalid")
        if credential["service_kind"] not in _SERVICE_KINDS:
            raise ValueError("runtime credential service kind is invalid")
        if credential["instance_name"] != instance:
            raise ValueError("runtime credential instance does not match request")
        generation = credential.get("bundle_generation")
        if not isinstance(generation, str) or _GENERATION_PATTERN.fullmatch(generation) is None:
            raise ValueError("runtime credential generation is invalid")
        credentials[instance] = raw
    if not credentials:
        raise ValueError("credential seal request cannot be empty")
    generations = {
        json.loads(value, object_pairs_hook=_unique_object)["bundle_generation"]
        for value in credentials.values()
    }
    if len(generations) != 1:
        raise ValueError("credential seal request mixes runtime generations")
    return credentials


def _decode_request(payload: bytes) -> _DecodedRequest:
    if not payload or len(payload) > _MAX_REQUEST_BYTES:
        raise ValueError("credential seal request size is unsafe")
    decoded = json.loads(payload, object_pairs_hook=_unique_object)
    if not isinstance(decoded, dict) or decoded.get("schema_version") != 2:
        raise ValueError("credential seal request version is invalid")
    operation = decoded.get("operation")
    if operation == "begin":
        if set(decoded) != {"schema_version", "operation", "credentials"}:
            raise ValueError("credential seal request shape is invalid")
        return _DecodedRequest(
            operation=operation,
            credentials=_decode_credentials(decoded["credentials"]),
        )
    if operation == "recover":
        if set(decoded) != {
            "schema_version",
            "operation",
            "bundle_generation",
            "instances",
            "action",
        }:
            raise ValueError("credential recovery request shape is invalid")
        generation = decoded.get("bundle_generation")
        if not isinstance(generation, str) or _GENERATION_PATTERN.fullmatch(generation) is None:
            raise ValueError("credential recovery generation is invalid")
        raw_instances = decoded.get("instances")
        if (
            not isinstance(raw_instances, list)
            or not raw_instances
            or any(
                not isinstance(instance, str) or _INSTANCE_PATTERN.fullmatch(instance) is None
                for instance in raw_instances
            )
            or len(raw_instances) != len(set(raw_instances))
        ):
            raise ValueError("credential recovery instances are invalid")
        action = decoded.get("action")
        if action not in {"commit", "rollback"}:
            raise ValueError("credential recovery action is invalid")
        return _DecodedRequest(
            operation=operation,
            bundle_generation=generation,
            instances=tuple(sorted(raw_instances)),
            action=action,
        )
    if operation not in {"commit", "rollback"}:
        raise ValueError("credential seal request operation is invalid")
    if set(decoded) != {"schema_version", "operation", "transaction_id"}:
        raise ValueError("credential seal request shape is invalid")
    transaction_id = decoded.get("transaction_id")
    if not isinstance(transaction_id, str) or _GENERATION_PATTERN.fullmatch(transaction_id) is None:
        raise ValueError("credential transaction id is invalid")
    return _DecodedRequest(operation=operation, transaction_id=transaction_id)


def _ensure_private_directory(path: Path, *, owner_uid: int) -> None:
    path.mkdir(mode=0o700, parents=True, exist_ok=True)
    observed = path.lstat()
    if (
        not stat.S_ISDIR(observed.st_mode)
        or stat.S_ISLNK(observed.st_mode)
        or observed.st_uid != owner_uid
    ):
        raise ValueError("credential store directory is unsafe")
    path.chmod(0o700)


def _write_private(path: Path, payload: bytes) -> None:
    descriptor = os.open(
        path,
        os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0),
        0o600,
    )
    try:
        os.fchmod(descriptor, 0o600)
        with os.fdopen(descriptor, "wb", closefd=True) as stream:
            descriptor = -1
            stream.write(payload)
            stream.flush()
            os.fsync(stream.fileno())
    finally:
        if descriptor >= 0:
            os.close(descriptor)


def _fsync_directory(path: Path) -> None:
    descriptor = os.open(path, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


def _write_private_atomic(path: Path, payload: bytes) -> None:
    descriptor, temporary_name = tempfile.mkstemp(prefix=".transaction-", dir=path.parent)
    temporary = Path(temporary_name)
    try:
        os.fchmod(descriptor, 0o600)
        with os.fdopen(descriptor, "wb", closefd=True) as stream:
            descriptor = -1
            stream.write(payload)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, path)
        _fsync_directory(path.parent)
    finally:
        if descriptor >= 0:
            os.close(descriptor)
        if temporary.exists() or temporary.is_symlink():
            temporary.unlink()


def _systemd_creds(operation: str, payload: bytes) -> bytes:
    result = subprocess.run(
        [
            "/usr/bin/systemd-creds",
            operation,
            "--name=capabilities.json",
            "-",
            "-",
        ],
        input=payload,
        check=False,
        capture_output=True,
    )
    if result.returncode != 0 or not result.stdout:
        raise RuntimeError(f"systemd-creds {operation} failed")
    return result.stdout


def _validate_pointer(pointer: Path) -> str | None:
    if not pointer.is_symlink() and not pointer.exists():
        return None
    if not pointer.is_symlink():
        raise ValueError("credential current pointer must be a symlink")
    target = os.readlink(pointer)
    parts = Path(target).parts
    if (
        len(parts) != 2
        or parts[0] != "generations"
        or re.fullmatch(r"[0-9a-f]{64}\.cred", parts[1]) is None
    ):
        raise ValueError("credential current pointer is invalid")
    return target


def _replace_pointer(pointer: Path, target: str) -> None:
    descriptor, temporary_name = tempfile.mkstemp(prefix=".current-", dir=pointer.parent)
    os.close(descriptor)
    os.unlink(temporary_name)
    temporary = Path(temporary_name)
    try:
        os.symlink(target, temporary)
        os.replace(temporary, pointer)
        _fsync_directory(pointer.parent)
    finally:
        if temporary.exists() or temporary.is_symlink():
            temporary.unlink()


def _remove_pointer(pointer: Path) -> None:
    if pointer.is_symlink():
        pointer.unlink()
        _fsync_directory(pointer.parent)
    elif pointer.exists():
        raise ValueError("credential current pointer must be a symlink")


def _transaction_payload(record: dict[str, object]) -> bytes:
    return json.dumps(
        record,
        ensure_ascii=True,
        separators=(",", ":"),
        sort_keys=True,
    ).encode()


def _read_transaction(path: Path, *, owner_uid: int) -> dict[str, object]:
    observed = path.lstat()
    if (
        not stat.S_ISREG(observed.st_mode)
        or stat.S_ISLNK(observed.st_mode)
        or observed.st_uid != owner_uid
        or stat.S_IMODE(observed.st_mode) != 0o600
    ):
        raise ValueError("credential transaction record is unsafe")
    decoded = json.loads(path.read_bytes(), object_pairs_hook=_unique_object)
    if not isinstance(decoded, dict) or decoded.get("schema_version") != 1:
        raise ValueError("credential transaction record is invalid")
    return decoded


def _receipt(operation: str, record: dict[str, object]) -> dict[str, object]:
    instances = record.get("instances")
    if not isinstance(instances, dict):
        raise ValueError("credential transaction instances are invalid")
    return {
        "schema_version": 2,
        "operation": operation,
        "transaction_id": record["transaction_id"],
        "sealed_instances": sorted(instances),
    }


def _recovery_receipt(
    request: _DecodedRequest,
    *,
    outcome: str,
    transaction_id: str | None,
) -> dict[str, object]:
    assert request.bundle_generation is not None
    return {
        "schema_version": 2,
        "operation": "recover",
        "bundle_generation": request.bundle_generation,
        "sealed_instances": list(request.instances),
        "outcome": outcome,
        "transaction_id": transaction_id,
    }


def _validate_stored_credential(
    path: Path,
    *,
    instance: str,
    generation: str,
    owner_uid: int,
    decrypt: Callable[[bytes], bytes],
) -> None:
    try:
        observed = path.lstat()
    except FileNotFoundError as exc:
        raise ValueError("credential recovery target is missing") from exc
    if (
        not stat.S_ISREG(observed.st_mode)
        or stat.S_ISLNK(observed.st_mode)
        or observed.st_uid != owner_uid
        or stat.S_IMODE(observed.st_mode) != 0o600
    ):
        raise ValueError("credential recovery target is unsafe")
    plaintext = decrypt(path.read_bytes())
    decoded = _decode_credentials({instance: base64.b64encode(plaintext).decode("ascii")})[instance]
    credential = json.loads(decoded, object_pairs_hook=_unique_object)
    if credential.get("bundle_generation") != generation:
        raise ValueError("credential recovery target generation is invalid")


def _validate_recovery_binding(
    record: dict[str, object],
    *,
    root: Path,
    active_path: Path,
    request: _DecodedRequest,
    owner_uid: int,
    decrypt: Callable[[bytes], bytes],
) -> None:
    if set(record) != {"schema_version", "transaction_id", "state", "instances"}:
        raise ValueError("credential recovery transaction record is invalid")
    transaction_id = record.get("transaction_id")
    if (
        not isinstance(transaction_id, str)
        or _GENERATION_PATTERN.fullmatch(transaction_id) is None
        or active_path.name != f"{transaction_id}.json"
    ):
        raise ValueError("credential recovery transaction identity is invalid")
    if record.get("state") not in {"prepared", "activated"}:
        raise RuntimeError("credential recovery transaction state is not recoverable")
    raw_instances = record.get("instances")
    if not isinstance(raw_instances, dict) or tuple(sorted(raw_instances)) != request.instances:
        raise RuntimeError("credential recovery transaction instances do not match")
    assert request.bundle_generation is not None
    expected_target = f"generations/{request.bundle_generation}.cred"
    for instance, raw_entry in raw_instances.items():
        if _INSTANCE_PATTERN.fullmatch(instance) is None or not isinstance(raw_entry, dict):
            raise ValueError("credential recovery transaction instance record is invalid")
        if set(raw_entry) != {"previous", "target", "created"}:
            raise ValueError("credential recovery transaction pointer record is invalid")
        previous = raw_entry.get("previous")
        if previous is not None and (
            not isinstance(previous, str)
            or re.fullmatch(r"generations/[0-9a-f]{64}\.cred", previous) is None
        ):
            raise ValueError("credential recovery previous pointer is invalid")
        if raw_entry.get("target") != expected_target:
            raise RuntimeError("credential recovery transaction generation does not match")
        if not isinstance(raw_entry.get("created"), bool):
            raise ValueError("credential recovery transaction creation marker is invalid")
        pointer = root / "instances" / instance / "current.cred"
        current = _validate_pointer(pointer)
        target = str(raw_entry["target"])
        if current not in {previous, target}:
            raise RuntimeError("credential recovery found an unexpected current pointer")
        if previous is not None:
            _validate_stored_credential(
                root / "instances" / instance / previous,
                instance=instance,
                generation=Path(previous).name.removesuffix(".cred"),
                owner_uid=owner_uid,
                decrypt=decrypt,
            )
        if request.action == "commit" or current == target:
            _validate_stored_credential(
                root / "instances" / instance / target,
                instance=instance,
                generation=request.bundle_generation,
                owner_uid=owner_uid,
                decrypt=decrypt,
            )


def _commit_transaction(
    record: dict[str, object],
    *,
    root: Path,
    active_path: Path,
    completed_root: Path,
) -> None:
    if record.get("state") != "activated":
        raise RuntimeError("credential transaction is not ready to commit")
    raw_instances = record.get("instances")
    if not isinstance(raw_instances, dict):
        raise ValueError("credential transaction instances are invalid")
    for instance, raw_entry in raw_instances.items():
        if not isinstance(raw_entry, dict):
            raise ValueError("credential transaction instance record is invalid")
        pointer = root / "instances" / instance / "current.cred"
        if _validate_pointer(pointer) != raw_entry.get("target"):
            raise RuntimeError("credential transaction current pointer changed before commit")
    _archive_transaction(
        record,
        active_path=active_path,
        completed_root=completed_root,
        state="committed",
    )


def _archive_transaction(
    record: dict[str, object],
    *,
    active_path: Path,
    completed_root: Path,
    state: str,
) -> None:
    archived = {**record, "state": state}
    completed_path = completed_root / f"{record['transaction_id']}.json"
    _write_private_atomic(completed_path, _transaction_payload(archived))
    active_path.unlink()
    _fsync_directory(active_path.parent)


def _restore_transaction(
    record: dict[str, object],
    *,
    root: Path,
    active_path: Path,
    completed_root: Path,
) -> None:
    raw_instances = record.get("instances")
    if not isinstance(raw_instances, dict):
        raise ValueError("credential transaction instances are invalid")
    try:
        for instance in sorted(raw_instances, reverse=True):
            raw_entry = raw_instances[instance]
            if not isinstance(raw_entry, dict):
                raise ValueError("credential transaction instance record is invalid")
            pointer = root / "instances" / instance / "current.cred"
            current = _validate_pointer(pointer)
            target = raw_entry.get("target")
            previous = raw_entry.get("previous")
            if not isinstance(target, str) or (
                previous is not None and not isinstance(previous, str)
            ):
                raise ValueError("credential transaction pointer record is invalid")
            if current == previous:
                continue
            if current != target:
                raise RuntimeError("credential rollback found an unexpected current pointer")
            if previous is None:
                _remove_pointer(pointer)
            else:
                _replace_pointer(pointer, previous)
        for instance in sorted(raw_instances):
            raw_entry = raw_instances[instance]
            if not isinstance(raw_entry, dict) or not raw_entry.get("created"):
                continue
            target = root / "instances" / instance / str(raw_entry["target"])
            target.unlink(missing_ok=True)
            _fsync_directory(target.parent)
    except BaseException as exc:
        failed = {
            **record,
            "state": "rollback_failed",
            "rollback_error": type(exc).__name__,
        }
        _write_private_atomic(active_path, _transaction_payload(failed))
        raise RuntimeError("credential rollback failed closed; audit retained") from exc
    _archive_transaction(
        record,
        active_path=active_path,
        completed_root=completed_root,
        state="rolled_back",
    )


def process_request(
    request_payload: bytes,
    *,
    store_root: Path = STORE_ROOT,
    owner_uid: int = 0,
    encrypt: Callable[[bytes], bytes] | None = None,
    decrypt: Callable[[bytes], bytes] | None = None,
) -> dict[str, object]:
    request = _decode_request(request_payload)
    operation = request.operation
    encryptor = encrypt or (lambda payload: _systemd_creds("encrypt", payload))
    decryptor = decrypt or (lambda payload: _systemd_creds("decrypt", payload))
    root = Path(store_root)
    if not root.is_absolute() or root != Path(os.path.abspath(root)):
        raise ValueError("credential store root must be absolute and normalized")
    _ensure_private_directory(root, owner_uid=owner_uid)
    instances_root = root / "instances"
    _ensure_private_directory(instances_root, owner_uid=owner_uid)
    transactions_root = root / "transactions"
    active_root = transactions_root / "active"
    completed_root = transactions_root / "completed"
    _ensure_private_directory(transactions_root, owner_uid=owner_uid)
    _ensure_private_directory(active_root, owner_uid=owner_uid)
    _ensure_private_directory(completed_root, owner_uid=owner_uid)

    if operation == "recover":
        active_paths = tuple(sorted(active_root.iterdir()))
        if not active_paths:
            return _recovery_receipt(request, outcome="none", transaction_id=None)
        if len(active_paths) != 1:
            raise RuntimeError("credential recovery found ambiguous active transactions")
        active_path = active_paths[0]
        record = _read_transaction(active_path, owner_uid=owner_uid)
        _validate_recovery_binding(
            record,
            root=root,
            active_path=active_path,
            request=request,
            owner_uid=owner_uid,
            decrypt=decryptor,
        )
        transaction_id = str(record["transaction_id"])
        if request.action == "rollback":
            _restore_transaction(
                record,
                root=root,
                active_path=active_path,
                completed_root=completed_root,
            )
            return _recovery_receipt(
                request,
                outcome="rolled_back",
                transaction_id=transaction_id,
            )
        _commit_transaction(
            record,
            root=root,
            active_path=active_path,
            completed_root=completed_root,
        )
        return _recovery_receipt(
            request,
            outcome="committed",
            transaction_id=transaction_id,
        )

    if operation != "begin":
        transaction_id = request.transaction_id
        assert transaction_id is not None
        active_path = active_root / f"{transaction_id}.json"
        completed_path = completed_root / f"{transaction_id}.json"
        if not active_path.exists():
            if not completed_path.exists():
                raise ValueError("credential transaction does not exist")
            completed = _read_transaction(completed_path, owner_uid=owner_uid)
            expected_state = "committed" if operation == "commit" else "rolled_back"
            if completed.get("state") != expected_state:
                raise RuntimeError("credential transaction is already finalized differently")
            return _receipt(operation, completed)
        record = _read_transaction(active_path, owner_uid=owner_uid)
        if record.get("transaction_id") != transaction_id:
            raise ValueError("credential transaction identity does not match")
        if operation == "rollback":
            _restore_transaction(
                record,
                root=root,
                active_path=active_path,
                completed_root=completed_root,
            )
            return _receipt(operation, record)
        _commit_transaction(
            record,
            root=root,
            active_path=active_path,
            completed_root=completed_root,
        )
        return _receipt(operation, record)

    credentials = request.credentials
    assert credentials is not None
    if tuple(active_root.iterdir()):
        raise RuntimeError("unfinished credential transaction requires recovery")
    transaction_id = secrets.token_hex(32)
    active_path = active_root / f"{transaction_id}.json"
    entries: dict[str, dict[str, object]] = {}
    created: list[Path] = []
    try:
        for instance, plaintext in credentials.items():
            generation = json.loads(plaintext)["bundle_generation"]
            instance_root = instances_root / instance
            generations_root = instance_root / "generations"
            _ensure_private_directory(instance_root, owner_uid=owner_uid)
            _ensure_private_directory(generations_root, owner_uid=owner_uid)
            target = generations_root / f"{generation}.cred"
            if target.exists() or target.is_symlink():
                observed = target.lstat()
                if (
                    not stat.S_ISREG(observed.st_mode)
                    or observed.st_uid != owner_uid
                    or stat.S_IMODE(observed.st_mode) != 0o600
                    or decryptor(target.read_bytes()) != plaintext
                ):
                    raise ValueError("existing encrypted runtime credential is unsafe")
            else:
                _write_private(target, encryptor(plaintext))
                _fsync_directory(generations_root)
                created.append(target)
            pointer = instance_root / "current.cred"
            previous = _validate_pointer(pointer)
            entries[instance] = {
                "previous": previous,
                "target": f"generations/{generation}.cred",
                "created": target in created,
            }
        record: dict[str, object] = {
            "schema_version": 1,
            "transaction_id": transaction_id,
            "state": "prepared",
            "instances": entries,
        }
        _write_private_atomic(active_path, _transaction_payload(record))
        try:
            for instance, entry in sorted(entries.items()):
                _replace_pointer(
                    root / "instances" / instance / "current.cred",
                    str(entry["target"]),
                )
        except BaseException:
            _restore_transaction(
                record,
                root=root,
                active_path=active_path,
                completed_root=completed_root,
            )
            raise
        record["state"] = "activated"
        _write_private_atomic(active_path, _transaction_payload(record))
        return _receipt(operation, record)
    except BaseException:
        if not active_path.exists():
            for target in created:
                target.unlink(missing_ok=True)
                _fsync_directory(target.parent)
        raise


def main() -> int:
    if len(sys.argv) != 1:
        raise ValueError("runtime credential sealer does not accept arguments")
    if os.geteuid() != 0:
        raise PermissionError("runtime credential sealer must run as root")
    request = sys.stdin.buffer.read(_MAX_REQUEST_BYTES + 1)
    receipt = process_request(request, owner_uid=0)
    response = json.dumps(
        receipt,
        ensure_ascii=True,
        separators=(",", ":"),
        sort_keys=True,
    ).encode()
    sys.stdout.buffer.write(response)
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except Exception as exc:
        print(f"credential sealing failed: {type(exc).__name__}", file=sys.stderr)
        raise SystemExit(1) from None
