#!/usr/bin/python3
"""Root-owned, fixed-destination systemd credential sealing helper."""

from __future__ import annotations

import base64
import json
import os
import re
import stat
import subprocess
import sys
import tempfile
from collections.abc import Callable
from pathlib import Path

STORE_ROOT = Path("/etc/credstore.encrypted/rquant-runtime")
_INSTANCE_PATTERN = re.compile(r"^svc-[0-9a-f]{64}$")
_GENERATION_PATTERN = re.compile(r"^[0-9a-f]{64}$")
_MAX_REQUEST_BYTES = 4 * 1024 * 1024
_MAX_CREDENTIAL_BYTES = 1024 * 1024


def _unique_object(pairs: list[tuple[str, object]]) -> dict[str, object]:
    result: dict[str, object] = {}
    for key, value in pairs:
        if key in result:
            raise ValueError("duplicate JSON key")
        result[key] = value
    return result


def _decode_request(payload: bytes) -> dict[str, bytes]:
    if not payload or len(payload) > _MAX_REQUEST_BYTES:
        raise ValueError("credential seal request size is unsafe")
    decoded = json.loads(payload, object_pairs_hook=_unique_object)
    if not isinstance(decoded, dict) or set(decoded) != {"schema_version", "credentials"}:
        raise ValueError("credential seal request shape is invalid")
    if decoded["schema_version"] != 1 or not isinstance(decoded["credentials"], dict):
        raise ValueError("credential seal request version is invalid")
    credentials: dict[str, bytes] = {}
    for instance, encoded in sorted(decoded["credentials"].items()):
        if not isinstance(instance, str) or _INSTANCE_PATTERN.fullmatch(instance) is None:
            raise ValueError("credential seal request instance is invalid")
        if not isinstance(encoded, str):
            raise ValueError("credential seal request payload is invalid")
        raw = base64.b64decode(encoded, validate=True)
        if not raw or len(raw) > _MAX_CREDENTIAL_BYTES:
            raise ValueError("runtime credential size is unsafe")
        credential = json.loads(raw, object_pairs_hook=_unique_object)
        if (
            not isinstance(credential, dict)
            or set(credential) != {"schema_version", "bundle_generation", "capabilities"}
            or credential["schema_version"] != 1
            or not isinstance(credential["capabilities"], dict)
        ):
            raise ValueError("runtime credential shape is invalid")
        generation = credential.get("bundle_generation")
        if not isinstance(generation, str) or _GENERATION_PATTERN.fullmatch(generation) is None:
            raise ValueError("runtime credential generation is invalid")
        credentials[instance] = raw
    if not credentials:
        raise ValueError("credential seal request cannot be empty")
    generations = {
        json.loads(payload, object_pairs_hook=_unique_object)["bundle_generation"]
        for payload in credentials.values()
    }
    if len(generations) != 1:
        raise ValueError("credential seal request mixes runtime generations")
    return credentials


def _ensure_private_directory(path: Path, *, owner_uid: int) -> None:
    path.mkdir(mode=0o700, parents=True, exist_ok=True)
    observed = path.lstat()
    if (
        not stat.S_ISDIR(observed.st_mode)
        or stat.S_ISLNK(observed.st_mode)
        or observed.st_uid != owner_uid
    ):
        raise ValueError("credential store directory is unsafe")
    path.chmod(0o700)


def _write_private(path: Path, payload: bytes) -> None:
    descriptor = os.open(
        path,
        os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0),
        0o600,
    )
    try:
        os.fchmod(descriptor, 0o600)
        with os.fdopen(descriptor, "wb", closefd=True) as stream:
            descriptor = -1
            stream.write(payload)
            stream.flush()
            os.fsync(stream.fileno())
    finally:
        if descriptor >= 0:
            os.close(descriptor)


def _systemd_creds(operation: str, payload: bytes) -> bytes:
    result = subprocess.run(
        [
            "/usr/bin/systemd-creds",
            operation,
            "--name=capabilities.json",
            "-",
            "-",
        ],
        input=payload,
        check=False,
        capture_output=True,
    )
    if result.returncode != 0 or not result.stdout:
        raise RuntimeError(f"systemd-creds {operation} failed")
    return result.stdout


def _validate_pointer(pointer: Path) -> str | None:
    if not pointer.is_symlink() and not pointer.exists():
        return None
    if not pointer.is_symlink():
        raise ValueError("credential current pointer must be a symlink")
    target = os.readlink(pointer)
    parts = Path(target).parts
    if (
        len(parts) != 2
        or parts[0] != "generations"
        or re.fullmatch(r"[0-9a-f]{64}\.cred", parts[1]) is None
    ):
        raise ValueError("credential current pointer is invalid")
    return target


def _replace_pointer(pointer: Path, target: str) -> None:
    descriptor, temporary_name = tempfile.mkstemp(prefix=".current-", dir=pointer.parent)
    os.close(descriptor)
    os.unlink(temporary_name)
    temporary = Path(temporary_name)
    try:
        os.symlink(target, temporary)
        os.replace(temporary, pointer)
    finally:
        if temporary.exists() or temporary.is_symlink():
            temporary.unlink()


def seal_request(
    request_payload: bytes,
    *,
    store_root: Path = STORE_ROOT,
    owner_uid: int = 0,
    encrypt: Callable[[bytes], bytes] | None = None,
    decrypt: Callable[[bytes], bytes] | None = None,
) -> tuple[str, ...]:
    credentials = _decode_request(request_payload)
    encryptor = encrypt or (lambda payload: _systemd_creds("encrypt", payload))
    decryptor = decrypt or (lambda payload: _systemd_creds("decrypt", payload))
    root = Path(store_root)
    if not root.is_absolute() or root != Path(os.path.abspath(root)):
        raise ValueError("credential store root must be absolute and normalized")
    _ensure_private_directory(root, owner_uid=owner_uid)
    instances_root = root / "instances"
    _ensure_private_directory(instances_root, owner_uid=owner_uid)

    staged: list[tuple[Path, str, str | None]] = []
    created: list[Path] = []
    try:
        for instance, plaintext in credentials.items():
            generation = json.loads(plaintext)["bundle_generation"]
            instance_root = instances_root / instance
            generations_root = instance_root / "generations"
            _ensure_private_directory(instance_root, owner_uid=owner_uid)
            _ensure_private_directory(generations_root, owner_uid=owner_uid)
            target = generations_root / f"{generation}.cred"
            if target.exists() or target.is_symlink():
                observed = target.lstat()
                if (
                    not stat.S_ISREG(observed.st_mode)
                    or observed.st_uid != owner_uid
                    or stat.S_IMODE(observed.st_mode) != 0o600
                    or decryptor(target.read_bytes()) != plaintext
                ):
                    raise ValueError("existing encrypted runtime credential is unsafe")
            else:
                _write_private(target, encryptor(plaintext))
                created.append(target)
            pointer = instance_root / "current.cred"
            previous = _validate_pointer(pointer)
            staged.append((pointer, f"generations/{generation}.cred", previous))

        switched: list[tuple[Path, str | None]] = []
        try:
            for pointer, target, previous in staged:
                _replace_pointer(pointer, target)
                switched.append((pointer, previous))
        except BaseException:
            for pointer, previous in reversed(switched):
                if previous is None:
                    pointer.unlink(missing_ok=True)
                else:
                    _replace_pointer(pointer, previous)
            raise
    except BaseException:
        for target in created:
            target.unlink(missing_ok=True)
        raise
    return tuple(sorted(credentials))


def main() -> int:
    if len(sys.argv) != 1:
        raise ValueError("runtime credential sealer does not accept arguments")
    if os.geteuid() != 0:
        raise PermissionError("runtime credential sealer must run as root")
    request = sys.stdin.buffer.read(_MAX_REQUEST_BYTES + 1)
    sealed = seal_request(request, owner_uid=0)
    response = json.dumps(
        {"sealed_instances": sealed},
        ensure_ascii=True,
        separators=(",", ":"),
        sort_keys=True,
    ).encode()
    sys.stdout.buffer.write(response)
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except Exception as exc:
        print(f"credential sealing failed: {type(exc).__name__}", file=sys.stderr)
        raise SystemExit(1) from None
