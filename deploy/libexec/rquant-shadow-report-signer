MAX_KEY_FILE_BYTES = 64 * 1024
MAX_CALENDAR_FILE_BYTES = 4 * 1024 * 1024
MAX_EXPORT_BYTES = 128 * 1024 * 1024
READ_CHUNK_BYTES = 1024 * 1024
KEY_ID = re.compile(r"^[a-z0-9][a-z0-9_.-]{0,127}$")
SHA256 = re.compile(r"^[0-9a-f]{64}$")
SIGNATURE = re.compile(r"^[A-Za-z0-9+/]{86}==$")
COMMIT = re.compile(r"^[0-9a-f]{40}$")
STAGING_NAME = re.compile(r"^\.staging-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9a-f]{32}$")
BOOT_ID = re.compile(r"^[0-9a-f-]{36}$")
