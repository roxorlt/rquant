_UTC = timezone.utc  # noqa: UP017 - deployed helper supports system Python 3.9.
_DIRECTORY_FLAGS = (
    os.O_RDONLY
    | getattr(os, "O_DIRECTORY", 0)
    | getattr(os, "O_NOFOLLOW", 0)
    | getattr(os, "O_CLOEXEC", 0)
)
RECOVERY_WINDOW = timedelta(minutes=5)
RECOVERY_CLOCK_TOLERANCE = timedelta(seconds=5)
SHANGHAI = ZoneInfo("Asia/Shanghai")
NAMESPACES = frozenset(
    {
        "rquant-shadow-completion-attestation",
