  },
  "motion-rule": {
    "flash-gap": "1000ms",
    "skeleton-delay": "300ms",
    "note": "flash-gap：同一单元格两次闪烁的最小间隔；skeleton-delay：请求超过这个时间才显示骨架。motion.fast/base/ease 为 v0.1 旧名，与 duration.fast/base、easing.standard 同值，保留兼容"
  }
