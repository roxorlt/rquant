# rQuant 环境变量模板
# 使用方法：cp .env.example .env，然后填入真实值
# 注意：.env 不要提交进 git

# ===== Tushare Pro =====
# 申请地址：https://tushare.pro/register
# 注册后在「个人中心」→「接口 TOKEN」查看
TUSHARE_TOKEN_MAIN=
TUSHARE_TOKEN_BACKUP=
# 仅用于登录 Tushare 网页查看文档；不要提交真实账号密码
TUSHARE_LOGIN_USERNAME=
TUSHARE_LOGIN_PASSWORD=
# 登录后浏览器 Cookie，用于抓取官方文档 HTML；不要提交真实 Cookie
TUSHARE_COOKIE=

# ===== 存储路径（绝对路径，不要用 ~ 或相对路径）=====
DATA_DIR=/absolute/path/to/rquant/data
DUCKDB_PATH=/absolute/path/to/rquant/data/rquant.duckdb
# 只读副本路径（dashboard/canvas/nl-screen 读这个文件，避开 monitor 写锁）
# 留空则从 DUCKDB_PATH 派生（同目录 + _ro 后缀），由 rquant-replica-sync.timer 每 5min 同步
DUCKDB_READONLY_PATH=
# 历史回补 manifest/task 状态使用独立 SQLite，避免 DuckDB 写锁阻塞状态查询
# 留空则使用 DATA_DIR/backfill_state.sqlite3；busy timeout 单位为毫秒
BACKFILL_STATE_PATH=
BACKFILL_STATE_BUSY_TIMEOUT_MS=5000
# backfill-plan 的 DuckDB 连接资源上限；spill 使用命令级临时目录
BACKFILL_PLANNER_MEMORY_LIMIT_MB=2048
BACKFILL_PLANNER_THREADS=2
# Strategy Lab 持久控制面：SQLite 仅由 lab-scheduler 写入；页面只投递命令文件。
# 留空时所有 Lab 状态都放入 DATA_DIR/lab-runtime 私有根；现有共享 DATA_DIR 不会被 chmod。
# 各路径必须是 LAB_RUNTIME_DIR 的互异直接子项，首次安装由 lab-runtime-prepare 安全迁移旧路径。
LAB_RUNTIME_DIR=
LAB_JOBS_PATH=
LAB_JOB_COMMAND_DIR=
LAB_JOB_CLAIM_DIR=
LAB_JOB_REPORT_DIR=
LAB_WORKER_ARTIFACT_DIR=
LAB_FINAL_ARTIFACT_DIR=
LAB_ARTIFACT_COMMIT_DIR=
LAB_DAEMON_LOCK_DIR=
LAB_FINALIZER_STATE_DIR=
LAB_READINESS_DIR=
# 以下部署控制项由 stdlib bootstrap 从 owner-only 0600 .env 按 allowlist 读取，不会 source/eval。
# 进程环境或命令行显式值优先；Linux 固定忽略本地 Lab lifecycle 并使用 uninstalled。
RQUANT_DEPLOY_UV=
RQUANT_DEPLOY_COMMAND_TIMEOUT_SECONDS=300
RQUANT_DEPLOY_OVERALL_TIMEOUT_SECONDS=1800
RQUANT_RELEASE_GENERATION_GC_GRACE_SECONDS=604800
RQUANT_RELEASE_GENERATION_MIN_FREE_BYTES=2147483648
RQUANT_RELEASE_PROFILE=
RQUANT_LAB_LIFECYCLE_MODE=
LAB_TRUSTED_GIT_PATH=/usr/bin/git
# finalizer HMAC 权限文件不会由 daemon 自动生成。两个文件必须为当前用户所有且 chmod 600：
# active key 文件仅含至少 32 bytes 的小写 hex；keyring JSON 格式为
# {"schema_version":1,"keys":{"<key-id>":"<hex>","<old-key-id>":"<hex>"}}
# keyring 保留旧 key 可让 scheduler 验证轮换前尚未消费的 commit。
LAB_FINALIZER_AUTHORITY_KEY_ID=
LAB_FINALIZER_AUTHORITY_KEY_PATH=
LAB_FINALIZER_AUTHORITY_KEYRING_PATH=
# V2 worker D-gate: an owner-protected canonical JSON bundle containing only
# finalizer/root/source-plan public verification records, the signed external
# certificate, and a read-only current-claim Unix endpoint policy.  No private
# key is valid in this file.  Leave disabled for V1-only deployments.
LAB_V2_CLAIM_PUBLICATION_ENABLED=false
LAB_CLAIM_PUBLICATION_WORKER_VERIFIER_PATH=
# Dedicated authority-owned claim finalizer.  Production selects exactly one
# generation by the regular-file ``current`` pointer below; each generation
# contains its private files and its paired public worker verifier.  Never put
# a private value in this environment file.
LAB_CLAIM_FINALIZER_ENABLED=false
LAB_CLAIM_FINALIZER_RUNTIME_MATERIAL_ROOT=
# Deployment trust boundary; production requires a root-owned physical base.
LAB_CLAIM_FINALIZER_RUNTIME_TRUSTED_BASE=/etc/rquant
# Legacy isolated-fixture path only; production must leave this empty.
LAB_CLAIM_FINALIZER_RUNTIME_MATERIAL_PATH=
LAB_CLAIM_FINALIZER_OWNER_ID=rquant-claim-finalizer
LAB_CLAIM_FINALIZER_LEASE_SECONDS=60
LAB_CLAIM_FINALIZER_POLL_INTERVAL_MS=500
LAB_CLAIM_FINALIZER_MAX_PUBLICATIONS_PER_TICK=16
LAB_CLAIM_FINALIZER_FAILURE_BACKOFF_SECONDS=1
LAB_CLAIM_FINALIZER_FAILURE_BACKOFF_MAX_SECONDS=30
# Independent high-water authority configuration is not accepted from .env.
# Production binds the fixed root helper, stable identity, timeout and public-only
# Ed25519 trusted keyring through the verified immutable generation profile.
# SQLite 锁等待与 scheduler 轮询间隔，单位毫秒
LAB_JOBS_BUSY_TIMEOUT_MS=5000
LAB_SCHEDULER_POLL_INTERVAL_MS=250
# scheduler 单例租约与心跳，单位秒；租约必须至少是心跳的 3 倍
LAB_SCHEDULER_LEASE_SECONDS=60
LAB_SCHEDULER_HEARTBEAT_SECONDS=10
# shard claim 租约与各单 tick 硬上限；worker ids 留空时只消费 report、不发布 claim
LAB_SCHEDULER_SHARD_LEASE_SECONDS=300
LAB_SCHEDULER_MAX_COMMANDS_PER_TICK=64
LAB_SCHEDULER_MAX_REPORTS_PER_TICK=64
LAB_SCHEDULER_MAX_PLANS_PER_TICK=64
LAB_SCHEDULER_MAX_CLAIMS_PER_TICK=16
LAB_SCHEDULER_MAX_CLAIM_AUTHORITY_PER_TICK=128
LAB_SCHEDULER_MAX_ARTIFACT_COMMITS_PER_TICK=64
LAB_SCHEDULER_FULL_INTEGRITY_INTERVAL_SECONDS=3600
LAB_SCHEDULER_FULL_INTEGRITY_BUDGET_SECONDS=30
LAB_SCHEDULER_WORKER_IDS=rquant-mac-primary
# launchd plist 使用同一个稳定 id；必须包含在上面的 scheduler allowlist
LAB_WORKER_ID=rquant-mac-primary
LAB_WORKER_POLL_INTERVAL_MS=250
LAB_WORKER_HEARTBEAT_SECONDS=30
LAB_WORKER_LEASE_EXTENSION_SECONDS=120
LAB_WORKER_RECEIPT_TIMEOUT_SECONDS=30
# worker.run_once 固定只消费一个 shard；其他值拒绝启动。
LAB_WORKER_MAX_SHARDS_PER_TICK=1
# 研究 worker 资源准入：版本、实时健康 authority 与不可变 SSE 交易日历缺一不可。
RQUANT_LAB_RESOURCE_POLICY_VERSION=lab-resource-v1
RQUANT_LAB_RESOURCE_AUTHORITY_CONFIG_JSON=
# 两个 owner-only canonical JSON 服务配置；同时配置后 preflight 会探测
# external root 与 resource journal socket 的 owner/peer/identity/capability。
# 生产 authority unit 不读取本应用 .env；它们分别读取
# /etc/rquant/external-root.env 与 /etc/rquant/resource-authority.env。
# 最小非业务字段清单见 deploy/env/*.env.example；不得复制数据源、通知或登录密钥。
RQUANT_EXTERNAL_MONOTONIC_ROOT_SERVICE_CONFIG_PATH=
RQUANT_RESOURCE_AUTHORITY_SERVICE_CONFIG_PATH=
RQUANT_LAB_LIVE_SLO_AUTHORITY_ROOT=/absolute/path/to/rquant/runtime/serving/runtime_health
RQUANT_LAB_TRADE_CALENDAR_PATH=/absolute/path/to/rquant/runtime/market-calendar.json
LAB_FINALIZER_POLL_INTERVAL_MS=1000
LAB_FINALIZER_MAX_JOBS_PER_TICK=8
# finalizer 失败按任务版本指纹做跨重启指数冷却；最大值必须不小于基础值
LAB_FINALIZER_FAILURE_COOLDOWN_SECONDS=30
LAB_FINALIZER_FAILURE_COOLDOWN_MAX_SECONDS=3600
# 不可变发布环境 GC 仅在独占 generation lock 内运行；配置见上方部署控制项。
# 通知去重/熔断状态使用独立 SQLite，不依赖可能正故障的 DuckDB
# 留空则使用 DATA_DIR/notification_state.sqlite3
NOTIFICATION_STATE_PATH=
NOTIFICATION_STATE_BUSY_TIMEOUT_MS=5000
PARQUET_DIR=/absolute/path/to/rquant/data/parquet
# 研究数据湖：Parquet 是研究事实，独立 DuckDB 只保存 manifest/覆盖度/导入审计
# 留空分别使用 DATA_DIR/research.duckdb、research_ro.duckdb、lake、research_staging
RESEARCH_DB_PATH=
RESEARCH_READONLY_DB_PATH=
RESEARCH_LAKE_DIR=
RESEARCH_STAGING_DIR=
# 云端完成首次迁移后才开启；开启后 monitor 在 09:25 固化当日预期分钟标的清单
RESEARCH_CLOUD_INGEST_ENABLED=false

# ===== 日志 =====
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR
LOG_DIR=/absolute/path/to/rquant/logs

# ===== 环境标识 =====
APP_ENV=dev                       # dev | prod
# 研究记录代码版本（可选）；本地有 .git 时会自动读取 HEAD，打包部署可显式注入
RQUANT_CODE_COMMIT=

# ===== 通知（Week 6 用）=====
# PushDeer：现阶段只推 admin（刘彤）的 iPhone + Mac，多设备 key 用逗号分隔
# 申请：https://www.pushdeer.com/  iOS/Mac App 安装后绑定可得 pushkey
# 端点默认 https://api2.pushdeer.com/message/push
# 示例：PUSHDEER_KEYS=<iphone-key>,<mac-key>
PUSHDEER_KEYS=
# 新 notifier 按设备独立确认，必须与 key 一一对应；路由策略也使用这些设备 ID
PUSHDEER_RECIPIENT_IDS=admin.iphone,admin.mac
PUSHDEER_ENDPOINT=https://api2.pushdeer.com/message/push

# PushPlus（微信公众号通道，多 token 用逗号分隔；为不装 PushDeer 的用户准备，如美丞）
# 申请：https://www.pushplus.plus/
PUSHPLUS_TOKENS=
PUSHPLUS_RECIPIENT_IDS=collaborator
PUSHPLUS_ENDPOINT=https://www.pushplus.plus/send

# ===== Artifact retention capability（仅云端 .env；部署 bundle 只保存密文 credential）=====
# 由受控密钥轮换生成的单行 JSON。不要写入 manifest、deployment profile 或任何研究产物。
RQ_ARTIFACT_RETENTION_WRITER_CREDENTIAL=

# 通知开关（默认全开，关掉对应类型可设为 false）
NOTIFY_ENABLED=true              # 总开关
NOTIFY_PRICE_LEVEL=true          # A 档位触发
NOTIFY_POOL2_EXIT=true           # B Pool 2 退出汇总
NOTIFY_DAILY_SUMMARY=true        # C 每日筛选汇总
NOTIFY_ERROR=true                # D 系统异常
NOTIFY_ERROR_COOLDOWN_SECONDS=1800  # 同一异常跨进程/重启最多每 30 分钟发送一次
NOTIFY_OPS_COOLDOWN_SECONDS=1800    # systemd/watchdog 同一运维事件冷却时间
NOTIFY_HEARTBEAT=true            # E 启停心跳
NOTIFY_SURGE_WATCH=true          # H 每分钟爆量确认（只推 PushDeer admin）

# ===== surge-watch（每分钟爆量推送，云端跑）=====
# 检测板块（缺省创业+科创）；可 all / main / gem,star 等，逗号分隔
# RQUANT_SURGE_BOARDS=gem,star

# ===== panorama 云端 feed（P2：Mac 优先读云端 surge 全市场快照）=====
# 配置后 panorama poller 第 0 路由优先拉云端（≤120s 新鲜则本机不自拉）；
# 未配 → 行为与现状完全一致（零风险）。basic auth 复用 backup htpasswd。
# RQUANT_CLOUD_FEED_URL=http://82.156.0.68:8081/feed/snapshot_full.parquet
# RQUANT_CLOUD_FEED_USER=
# RQUANT_CLOUD_FEED_PASS=

# ===== 盘中分钟行情源开关 =====
# 默认 tushare：以 Tushare「A股分钟RT」rt_min（付费权限 ¥1000/年）为主源，akshare sina 兜底
# 紧急回退：权限到期 / 接口故障 / 费用止损时填 akshare，不改代码即切回纯 akshare 主源
# 留空 = tushare（默认）；只允许 tushare / akshare，其他值启动时报错
INTRADAY_QUOTE_SOURCE=

# ===== 盘中 rt_min 轮询节流（秒）=====
# monitor 主循环 interval=5s，但 rt_min 是分钟级数据，5s 打一次 API 纯烧配额。
# 距上次成功拉取不足该间隔时跳过 API 调用、用内存缓存合成行情（默认 15）。
# 已确认接受的运营风险：云端 monitor 盘中每 5s 写 minute_bar，replica-sync 的 cp
# 撞写概率增大，只读副本盘中滞后可能超 5min（verify 兜底不撕裂，仅滞后）。
RT_MIN_POLL_SECONDS=15

# ===== Pool 2 自动踢出阈值 =====
# Pool 2 入池超过 N 个交易日（含入池日计 1 天）自动踢出，exit_reason=aged_out
# 比"早期提醒（≥3 日 expired_held）"更严，是硬退出兜底
POOL2_MAX_AGE_DAYS=6

# ===== Backup HTTP API（mac 拉云端备份用，绕开 SSH/fail2ban）=====
# 服务器侧：写到 /etc/nginx/.rquant-backup.htpasswd（用 sudo htpasswd 生成）
# mac 侧：sync-from-cloud.sh 读这三个变量，curl --user 鉴权
RQUANT_BACKUP_USER=rquant
RQUANT_BACKUP_TOKEN=
RQUANT_BACKUP_URL=http://82.156.0.68:8081/backup

# ===== Upload HTTP API（mac push 配置数据到云端，与 /backup 对称）=====
# 服务器侧：写到 /www/server/nginx/conf/.rquant-upload.htpasswd（用 htpasswd 生成）
#         nginx /upload/ 走 dav_methods PUT，文件落到 /home/lighthouse/rquant/data/uploads/
# mac 侧：scripts/push-to-cloud.sh 读这三个变量，curl -T 上传
# 用途：risk_blacklist.parquet 等本地生成的"配置数据"推到云端
RQUANT_UPLOAD_USER=rquant-upload
RQUANT_UPLOAD_TOKEN=
RQUANT_UPLOAD_URL=http://82.156.0.68:8081/upload

# ===== LLM（Week 7 NL 选股）=====
# DeepSeek API，OpenAI-compatible，国内云直连无障碍
# 申请：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# ===== 全景页登录网关（微信友好 cookie 登录，替代 basic auth）=====
# 签名令牌密钥：部署时 `openssl rand -hex 32` 生成一次写这里，之后不要随意改
# （改了全体 cookie 失效、需重新登录）。为空则登录服务拒绝启动（不使用空密钥）。
RQUANT_PANORAMA_COOKIE_SECRET=
# 用户库路径（可选）：留空默认 DATA_DIR/panorama-users.txt（0600，CLI 自动创建）
# 行格式 user:pbkdf2_sha256$iter$salt$hash，用 `rquant panorama-user-add <name>` 管理
RQUANT_PANORAMA_USERS_PATH=
